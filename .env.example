# LifeVault Configuration Template (.env.example)

# Django Application Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Leave blank or set to postgresql://... for PostgreSQL)
# When DATABASE_URL is not set or DB_ENGINE is sqlite, SQLite will be used for local development/testing.
# DB_ENGINE=postgresql
# DB_NAME=lifevault_db
# DB_USER=vault_user
# DB_PASSWORD=vault_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Master Application-Level File Encryption Key (32 bytes base64-encoded for AES-256-GCM)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY=replace-with-32-byte-base64-encoded-key

# Storage Settings
VAULT_STORAGE_ROOT=storage/private
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Celery & Redis Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional Email / SMTP Settings (Defaults to console backend if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LifeVault Security <no-reply@lifevault.local>
